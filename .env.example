# Twinkle Stars Kindergarten - Environment Variables

# Vercel Postgres (auto-set when you add Postgres storage in Vercel dashboard)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Admin authentication
ADMIN_PASSWORD=your-secure-password-here
# Optional: pre-computed SHA256 hash (password + JWT_SECRET) instead of plain ADMIN_PASSWORD
# ADMIN_PASSWORD_HASH=

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-this-to-a-long-random-string

# Optional: restrict CORS to your domain
# ALLOWED_ORIGIN=https://your-domain.vercel.app
